# Copy to .env and fill in. Never commit .env.
# Optional: enables the AI qualification and drafting layer. Without it the
# engine still runs using deterministic rules and templates.
ANTHROPIC_API_KEY=
# Model used for qualification and drafting (default claude-opus-5).
LEADGEN_MODEL=claude-opus-5
# Where the local pipeline database lives.
LEADGEN_DB_PATH=data/leads.sqlite3
# Your sender identity, used in outreach templates.
LEADGEN_SENDER_NAME=
LEADGEN_SENDER_TITLE=Partnerships
LEADGEN_SENDER_PHONE=
# Identify yourself to the SEC EDGAR API (their policy for automated clients).
LEADGEN_SEC_USER_AGENT=
# Netlify personal access token, used only to read capacity-check form submissions (leadgen import-form --netlify).
NETLIFY_AUTH_TOKEN=
# Netlify site ID of each website (in each site's settings), used with the token above.
# One per domain, comma-separated (e.g. bakery,pet,formulation,pet-formulation site IDs); each is pulled and reported on its own.
NETLIFY_SITE_ID=
# Weekly report email (scripts/weekly_pipeline.sh). Gmail: smtp.gmail.com, port 587, an app password.
LEADGEN_SMTP_HOST=
LEADGEN_SMTP_PORT=587
LEADGEN_SMTP_USER=
LEADGEN_SMTP_PASSWORD=
LEADGEN_REPORT_TO=
