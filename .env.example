# Copy to .env and fill in. Never commit .env.
# Optional: enables the AI qualification and drafting layer. Without it the
# engine still runs using deterministic rules and templates.
ANTHROPIC_API_KEY=
# Model used for qualification and drafting (default claude-opus-5).
LEADGEN_MODEL=claude-opus-5
# Where the local pipeline database lives.
LEADGEN_DB_PATH=data/leads.sqlite3
# Your sender identity, used in outreach templates.
LEADGEN_SENDER_NAME=
LEADGEN_SENDER_TITLE=Partnerships
LEADGEN_SENDER_PHONE=
# Identify yourself to the SEC EDGAR API (their policy for automated clients).
LEADGEN_SEC_USER_AGENT=
